-- Users table
CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    discord_username TEXT,
    bio TEXT,
    meeting_preferences TEXT,
    rating REAL DEFAULT 0.00,
    total_reviews INTEGER DEFAULT 0,
    total_sessions INTEGER DEFAULT 0,
    no_show_count INTEGER DEFAULT 0,
    is_suspended INTEGER DEFAULT 0,
    is_admin INTEGER DEFAULT 0,
    marketing_opt_in_at DATETIME,
    public_handle TEXT,
    portfolio_public INTEGER NOT NULL DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Skills table
CREATE TABLE IF NOT EXISTS skills (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    skill_name TEXT NOT NULL,
    proficiency TEXT CHECK (proficiency IN ('beginner', 'intermediate', 'advanced')),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    UNIQUE(user_id, skill_name)
);

-- Availability table
CREATE TABLE IF NOT EXISTS availability (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    day_of_week INTEGER CHECK (day_of_week >= 0 AND day_of_week <= 6),
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    UNIQUE(user_id, day_of_week, start_time)
);

-- Bookings table
CREATE TABLE IF NOT EXISTS bookings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tutor_id INTEGER NOT NULL,
    student_id INTEGER NOT NULL,
    session_date TEXT NOT NULL,
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    topic TEXT NOT NULL,
    meeting_type TEXT CHECK (meeting_type IN ('in_person', 'online')),
    status TEXT DEFAULT 'pending' CHECK (status IN ('pending', 'confirmed', 'completed', 'cancelled', 'no_show')),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (tutor_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (student_id) REFERENCES users(id) ON DELETE CASCADE,
    CHECK (tutor_id != student_id)
);

-- Reviews table
CREATE TABLE IF NOT EXISTS login_attempts (
    subject_key TEXT PRIMARY KEY,
    attempts INTEGER NOT NULL DEFAULT 0,
    window_started_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    locked_until DATETIME
);
CREATE INDEX IF NOT EXISTS idx_login_attempts_window ON login_attempts(window_started_at);

-- Reviews table
CREATE TABLE IF NOT EXISTS reviews (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    booking_id INTEGER NOT NULL,
    reviewer_id INTEGER NOT NULL,
    reviewee_id INTEGER NOT NULL,
    rating INTEGER CHECK (rating >= 1 AND rating <= 5),
    comment TEXT NOT NULL,
    tags TEXT,
    would_book_again INTEGER,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (booking_id) REFERENCES bookings(id) ON DELETE CASCADE,
    FOREIGN KEY (reviewer_id) REFERENCES users(id),
    FOREIGN KEY (reviewee_id) REFERENCES users(id),
    UNIQUE(booking_id, reviewer_id)
);

-- Password reset tokens
CREATE TABLE IF NOT EXISTS password_reset_tokens (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    expires_at TIMESTAMP NOT NULL,
    used BOOLEAN DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_password_reset_token ON password_reset_tokens(token);

-- Timetable table (personal weekly study blocks)
CREATE TABLE IF NOT EXISTS timetable (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    day_of_week INTEGER CHECK (day_of_week >= 0 AND day_of_week <= 6),
    start_time TEXT NOT NULL,
    end_time TEXT NOT NULL,
    activity TEXT NOT NULL,
    goal TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

-- Activity logs (reflections on timetable blocks)
CREATE TABLE IF NOT EXISTS activity_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timetable_id INTEGER,
    activity_name VARCHAR(255) NOT NULL DEFAULT '',
    user_id INTEGER NOT NULL,
    log_date TEXT NOT NULL,
    summary TEXT NOT NULL DEFAULT '',
    challenges TEXT NOT NULL DEFAULT '',
    learnings TEXT NOT NULL DEFAULT '',
    audio_url TEXT,
    completed INTEGER DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (timetable_id) REFERENCES timetable(id) ON DELETE SET NULL,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    UNIQUE(timetable_id, user_id, log_date)
);

-- Indexes
CREATE INDEX IF NOT EXISTS idx_skills_user ON skills(user_id);
CREATE INDEX IF NOT EXISTS idx_skills_name ON skills(skill_name);
CREATE UNIQUE INDEX IF NOT EXISTS idx_users_public_handle ON users (lower(public_handle));
CREATE INDEX IF NOT EXISTS idx_availability_user ON availability(user_id);
CREATE INDEX IF NOT EXISTS idx_bookings_tutor ON bookings(tutor_id);
CREATE INDEX IF NOT EXISTS idx_bookings_student ON bookings(student_id);
CREATE INDEX IF NOT EXISTS idx_bookings_date ON bookings(session_date);
CREATE INDEX IF NOT EXISTS idx_reviews_reviewee ON reviews(reviewee_id);
CREATE INDEX IF NOT EXISTS idx_timetable_user ON timetable(user_id);
CREATE INDEX IF NOT EXISTS idx_activity_logs_timetable ON activity_logs(timetable_id);
CREATE INDEX IF NOT EXISTS idx_activity_logs_user ON activity_logs(user_id);

-- Project collaboration
CREATE TABLE IF NOT EXISTS collaboration_preferences (
    user_id INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    open_to_invites INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE IF NOT EXISTS projects (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    owner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    roles_needed TEXT NOT NULL,
    time_commitment TEXT NOT NULL,
    repo_url TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'closed')),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_projects_owner ON projects(owner_id);
CREATE TABLE IF NOT EXISTS project_requests (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('application', 'invitation')),
    note TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'accepted', 'declined')),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(project_id, user_id)
);
CREATE INDEX IF NOT EXISTS idx_project_requests_user ON project_requests(user_id);
CREATE TABLE IF NOT EXISTS project_members (
    project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    joined_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY(project_id, user_id)
);

-- Accountability buddy pairing (SQLite equivalent).
CREATE TABLE IF NOT EXISTS buddy_connections (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    requester_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    recipient_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'active', 'declined')),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK (requester_id <> recipient_id)
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_buddy_connections_pair ON buddy_connections (
    CASE WHEN requester_id < recipient_id THEN requester_id ELSE recipient_id END,
    CASE WHEN requester_id < recipient_id THEN recipient_id ELSE requester_id END
);
CREATE INDEX IF NOT EXISTS idx_buddy_connections_requester ON buddy_connections(requester_id, status);
CREATE INDEX IF NOT EXISTS idx_buddy_connections_recipient ON buddy_connections(recipient_id, status);

-- Public Learning Hub (SQLite equivalent of the PostgreSQL schema).
CREATE TABLE IF NOT EXISTS learning_articles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    slug TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    summary TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'Guide',
    body TEXT NOT NULL,
    published_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS learning_comments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    article_id INTEGER NOT NULL REFERENCES learning_articles(id) ON DELETE CASCADE,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    parent_id INTEGER REFERENCES learning_comments(id) ON DELETE CASCADE,
    body TEXT NOT NULL,
    minute_bucket INTEGER NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(user_id, minute_bucket)
);
CREATE INDEX IF NOT EXISTS idx_learning_comments_article ON learning_comments(article_id, created_at, id);
CREATE INDEX IF NOT EXISTS idx_learning_comments_parent ON learning_comments(parent_id);

-- In-app notifications (SQLite parity).
CREATE TABLE IF NOT EXISTS notifications (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    event_key TEXT NOT NULL,
    title TEXT NOT NULL,
    message TEXT NOT NULL DEFAULT '',
    link_url TEXT NOT NULL DEFAULT '/dashboard',
    is_read INTEGER NOT NULL DEFAULT 0 CHECK (is_read IN (0,1)),
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(user_id,event_key),
    CHECK (link_url LIKE '/%' AND link_url NOT LIKE '//%')
);
CREATE INDEX IF NOT EXISTS idx_notifications_user_id ON notifications(user_id,id DESC);
CREATE INDEX IF NOT EXISTS idx_notifications_unread ON notifications(user_id,is_read);
CREATE TRIGGER IF NOT EXISTS l2e_booking_insert AFTER INSERT ON bookings BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'booking:'||NEW.id||':'||COALESCE(NEW.status,'pending'),'Study booking requested',
        'A study booking request was created.','/my-bookings'
    FROM users WHERE id IN (NEW.tutor_id,NEW.student_id) AND COALESCE(is_suspended,0)=0;
END;
CREATE TRIGGER IF NOT EXISTS l2e_booking_update AFTER UPDATE OF status ON bookings
WHEN NEW.status IS NOT OLD.status BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'booking:'||NEW.id||':'||COALESCE(NEW.status,'pending'),'Study booking updated',
        'Booking status: '||COALESCE(NEW.status,'pending')||'.','/my-bookings'
    FROM users WHERE id IN (NEW.tutor_id,NEW.student_id) AND COALESCE(is_suspended,0)=0;
END;
CREATE TRIGGER IF NOT EXISTS l2e_buddy_insert AFTER INSERT ON buddy_connections
WHEN NEW.status='pending' BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'buddy:'||NEW.id||':pending','New buddy request',
        'A fellow would like to be your accountability buddy.','/buddies'
    FROM users WHERE id=NEW.recipient_id AND COALESCE(is_suspended,0)=0;
END;
CREATE TRIGGER IF NOT EXISTS l2e_buddy_update AFTER UPDATE OF status ON buddy_connections
WHEN NEW.status IS NOT OLD.status AND NEW.status IN ('active','declined') BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'buddy:'||NEW.id||':'||NEW.status,'Buddy request updated',
        CASE WHEN NEW.status='active' THEN 'Your buddy connection is now active.'
            ELSE 'Your buddy request was declined.' END,'/buddies'
    FROM users WHERE (id=NEW.requester_id OR (NEW.status='active' AND id=NEW.recipient_id))
        AND COALESCE(is_suspended,0)=0;
END;
CREATE TRIGGER IF NOT EXISTS l2e_reflection_insert AFTER INSERT ON activity_logs
WHEN NEW.completed=1 BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'reflection:'||NEW.id||':saved','Reflection saved',
        'Your learning reflection is ready in your history.','/reflections'
    FROM users WHERE id=NEW.user_id AND COALESCE(is_suspended,0)=0;
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT u.id,'reflection:'||NEW.id||':buddy','Your buddy reflected',
        'An accountability buddy logged a learning reflection.','/buddies'
    FROM buddy_connections bc JOIN users u ON u.id=
        CASE WHEN bc.requester_id=NEW.user_id THEN bc.recipient_id ELSE bc.requester_id END
    WHERE bc.status='active' AND (bc.requester_id=NEW.user_id OR bc.recipient_id=NEW.user_id)
        AND COALESCE(u.is_suspended,0)=0;
END;
CREATE TRIGGER IF NOT EXISTS l2e_reflection_update AFTER UPDATE OF completed ON activity_logs
WHEN NEW.completed=1 AND COALESCE(OLD.completed,0)<>1 BEGIN
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT id,'reflection:'||NEW.id||':saved','Reflection saved',
        'Your learning reflection is ready in your history.','/reflections'
    FROM users WHERE id=NEW.user_id AND COALESCE(is_suspended,0)=0;
    INSERT OR IGNORE INTO notifications(user_id,event_key,title,message,link_url)
    SELECT u.id,'reflection:'||NEW.id||':buddy','Your buddy reflected',
        'An accountability buddy logged a learning reflection.','/buddies'
    FROM buddy_connections bc JOIN users u ON u.id=
        CASE WHEN bc.requester_id=NEW.user_id THEN bc.recipient_id ELSE bc.requester_id END
    WHERE bc.status='active' AND (bc.requester_id=NEW.user_id OR bc.recipient_id=NEW.user_id)
        AND COALESCE(u.is_suspended,0)=0;
END;

-- Multi-seat masterclasses. Reservations are retained when cancelled.
CREATE TABLE IF NOT EXISTS masterclasses (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tutor_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    title VARCHAR(100) NOT NULL CHECK (length(title) BETWEEN 3 AND 100),
    description TEXT NOT NULL DEFAULT '' CHECK (length(description)<=2000),
    starts_at TEXT NOT NULL,
    duration_minutes INT NOT NULL CHECK (duration_minutes BETWEEN 15 AND 240),
    capacity INT NOT NULL CHECK (capacity BETWEEN 2 AND 100),
    status VARCHAR(12) NOT NULL DEFAULT 'scheduled' CHECK (status IN ('scheduled','cancelled')),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS masterclass_attendees (
    masterclass_id INTEGER NOT NULL REFERENCES masterclasses(id) ON DELETE CASCADE,
    user_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    status VARCHAR(12) NOT NULL DEFAULT 'reserved' CHECK (status IN ('reserved','cancelled')),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY(masterclass_id,user_id)
);
CREATE INDEX IF NOT EXISTS idx_masterclasses_upcoming ON masterclasses(status,starts_at,id);
CREATE INDEX IF NOT EXISTS idx_masterclasses_tutor ON masterclasses(tutor_id,id);
CREATE INDEX IF NOT EXISTS idx_masterclass_attendees_user ON masterclass_attendees(user_id,masterclass_id);
